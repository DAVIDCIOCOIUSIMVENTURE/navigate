// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
 // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int    @id @default(autoincrement())
  email     String @unique
  firstName String
  lastName  String
  problemTriggers ProblemTrigger[]
  problemTriggersBuckets ProblemTriggersBucket[]
}

model SelfDiscoveryQuestionCategory {
  id          Int    @id @default(autoincrement())
  title       String
  url         String
  description String
  questions SelfDiscoveryQuestion[]
}

model SelfDiscoveryQuestion {
  id                             Int    @id @default(autoincrement())
  titleId                        String
  url                            String
  title                          String
  description                    String
  selfDiscoveryQuestionCategoryId Int
  selfDiscoveryQuestionCategory   SelfDiscoveryQuestionCategory @relation(fields: [selfDiscoveryQuestionCategoryId], references: [id])
  problemTriggers ProblemTrigger[]
}

model ProblemTrigger {
  id                       Int     @id @default(autoincrement())
  title                    String
  userId                   Int
  user                     User    @relation(fields: [userId], references: [id])
  selfDiscoveryQuestionId  Int?
  selfDiscoveryQuestion    SelfDiscoveryQuestion? @relation(fields: [selfDiscoveryQuestionId], references: [id])
  problemTriggersBuckets ProblemTriggersBucket[]
}

model ProblemTriggersBucket {
  id            Int             @id @default(autoincrement())
  title         String
  userId        Int
  user          User            @relation(fields: [userId], references: [id])
  problemTriggers ProblemTrigger[]
}
