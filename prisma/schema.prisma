// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
 // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email     String @unique
  firstName String
  lastName  String
  problemTriggers ProblemTrigger[]
  problemTriggersBuckets ProblemTriggersBucket[]
}

model SelfDiscoveryQuestionCategory {
 id                    String                 @id @default(cuid())
  title       String
  url         String
  description String
  questions SelfDiscoveryQuestion[]
}

model SelfDiscoveryQuestion {
 id                    String                 @id @default(cuid())
  titleId                        String
  url                            String
  title                          String
  description                    String
  selfDiscoveryQuestionCategoryId String
  selfDiscoveryQuestionCategory   SelfDiscoveryQuestionCategory @relation(fields: [selfDiscoveryQuestionCategoryId], references: [id])
  problemTriggers ProblemTrigger[]
}

model ProblemTrigger {
  id                    String                 @id @default(cuid())
  title                    String
  userId                   String
  user                     User    @relation(fields: [userId], references: [id])
  selfDiscoveryQuestionId  String?
  selfDiscoveryQuestion    SelfDiscoveryQuestion? @relation(fields: [selfDiscoveryQuestionId], references: [id])
  problemTriggersBuckets ProblemTriggersBucket[]
}

model ProblemTriggersBucket {
 id                    String                 @id @default(cuid())
  title         String
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  problemTriggers ProblemTrigger[]
}
